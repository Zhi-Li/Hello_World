<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.screengate.service</string>
<key>ProgramArguments</key><array><string>/Library/Application Support/ScreenGate/ScreenGateService</string></array>
<key>RunAtLoad</key><true/>
<key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
<key>ThrottleInterval</key><integer>5</integer>
<key>ProcessType</key><string>Background</string>
<key>ExitTimeOut</key><integer>30</integer>
<key>Sockets</key><dict><key>Control</key><dict>
<key>SockFamily</key><string>Unix</string>
<key>SockType</key><string>stream</string>
<key>SockPathName</key><string>/var/run/com.screengate.control.sock</string>
<key>SockPathMode</key><integer>438</integer>
</dict></dict>
<key>StandardOutPath</key><string>/Library/Application Support/ScreenGate/service.log</string>
<key>StandardErrorPath</key><string>/Library/Application Support/ScreenGate/service.log</string>
</dict></plist>
